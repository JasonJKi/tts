# Backend selection: "auto", "mlx" (Mac), "vllm" (Linux+NVIDIA)
TTS_BACKEND=auto

# MLX backend (Apple Silicon) - model ID from HuggingFace
TTS_MLX_MODEL_ID=mlx-community/Voxtral-4B-TTS-2603-mlx-4bit

# vLLM-Omni backend (Linux + NVIDIA GPU)
TTS_VLLM_BASE_URL=http://localhost:8091
TTS_VLLM_MODEL_ID=mistralai/Voxtral-4B-TTS-2603

# Database (SQLite for dev, PostgreSQL for prod)
TTS_DATABASE_URL=sqlite+aiosqlite:///./data/db/voxtral.db

# Voice storage directory
TTS_VOICES_DIR=data/voices

# Server
TTS_HOST=0.0.0.0
TTS_PORT=8000
TTS_CORS_ORIGINS=["http://localhost:3000"]
TTS_DEBUG=false

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
